      "report_id": "rpt-20261014T180000Z-2f9b",
      "timestamp": "2026-10-14T18:00:00Z",
      "overall_status": "Fail",
      "exit_code": 1,
      "logic_used": "QF_LIA",
      "spec_hash": "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff",
      "query_hash": "ffeeddccbbaa99887766554433221100ffeeddccbbaa99887766554433221100",
      "proof_hash": "0f1e2d3c4b5a69788796a5b4c3d2e1f00f1e2d3c4b5a69788796a5b4c3d2e1f0",
